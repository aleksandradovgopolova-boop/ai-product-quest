{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArtifactTemplates",
  "type": "object",
  "required": ["artifacts"],
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "chapterId", "title", "format", "sections"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "chapterId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "format": { "enum": ["markdown"] },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
