{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneList",
  "type": "object",
  "required": ["scenes"],
  "additionalProperties": false,
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stepIndex", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stepIndex": { "type": "integer", "minimum": 1 },
          "time": { "type": "string" },
          "tone": { "enum": ["normal", "error", "success", "codex"] },
          "visual": { "enum": ["context", "signal"] },
          "chrome": { "enum": ["bare", "system"] },
          "presentation": { "enum": ["terminal", "dialogue", "title"] },
          "advanceMode": { "enum": ["any-input"] },
          "showEffects": { "type": "boolean" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "prompt": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "missing": { "type": "boolean" }
              }
            }
          },
          "hypothesis": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "evidenceIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "nextSceneId": { "type": "string", "minLength": 1 },
                "action": { "enum": ["artifacts", "codex", "reset"] },
                "setPrediction": { "type": "string" },
                "setVariables": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "string" }
                },
                "decisionId": { "type": "string" },
                "unlockCodexEntryId": { "type": "string" },
                "generateArtifactId": { "type": "string" },
                "tone": { "enum": ["quiet", "primary"] },
                "effects": {
                  "type": "object",
                  "additionalProperties": { "type": "number" }
                }
              }
            }
          },
          "autoAdvanceMs": { "type": "integer", "minimum": 0 },
          "autoNextSceneId": { "type": "string" }
        }
      }
    }
  }
}
