{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneList",
  "type": "object",
  "required": ["scenes"],
  "additionalProperties": false,
  "$defs": {
    "productComponent": {
      "enum": ["problem", "outcome", "modelRole", "context", "tools", "boundaries"]
    },
    "budget": {
      "type": "object",
      "required": ["limit", "label"],
      "additionalProperties": false,
      "properties": {
        "limit": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "capabilityStep": {
      "type": "object",
      "required": ["target", "select", "prompt"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/productComponent" },
        "select": { "enum": ["one", "many"] },
        "prompt": { "type": "string", "minLength": 1 },
        "budget": { "$ref": "#/$defs/budget" },
        "minSelected": { "type": "integer", "minimum": 0 },
        "confirmLabel": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "description": "What the scene lets the player do. The runner switches on `kind`, never on a scene id.",
      "type": "object",
      "required": ["kind", "nextSceneId"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["build", "run-tests", "rebuild"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capabilityStep" }
        },
        "maxChanges": { "type": "integer", "minimum": 1 },
        "createsVersion": { "type": "integer", "minimum": 1 },
        "confirmLabel": { "type": "string", "minLength": 1 },
        "nextSceneId": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "build" } }, "required": ["kind"] },
          "then": { "required": ["steps"] }
        },
        {
          "if": { "properties": { "kind": { "const": "rebuild" } }, "required": ["kind"] },
          "then": { "required": ["maxChanges"] }
        }
      ]
    }
  },
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "stepIndex", "lines"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stepIndex": { "type": "integer", "minimum": 1 },
          "tone": { "enum": ["normal", "error", "success", "codex"] },
          "visual": { "enum": ["context", "signal"] },
          "chrome": { "enum": ["bare", "system"] },
          "presentation": { "enum": ["terminal", "dialogue", "title"] },
          "advanceMode": { "enum": ["any-input"] },
          "showEffects": { "type": "boolean" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "prompt": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "text"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "text": { "type": "string" },
                "missing": { "type": "boolean" }
              }
            }
          },
          "hypothesis": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "evidenceIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "nextSceneId": { "type": "string", "minLength": 1 },
                "action": { "enum": ["artifacts", "codex", "reset"] },
                "setPrediction": { "type": "string" },
                "setVariables": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "string" }
                },
                "decisionId": { "type": "string" },
                "unlockCodexEntryId": { "type": "string" },
                "generateArtifactId": { "type": "string" },
                "tone": { "enum": ["quiet", "primary"] },
                "effects": {
                  "type": "object",
                  "additionalProperties": { "type": "number" }
                }
              }
            }
          },
          "capability": { "$ref": "#/$defs/capability" },
          "autoAdvanceMs": { "type": "integer", "minimum": 0 },
          "autoNextSceneId": { "type": "string" }
        }
      }
    }
  }
}
