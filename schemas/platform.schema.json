{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform",
  "type": "object",
  "required": ["id", "title", "defaultSeasonId", "defaultChapterId", "defaultRoute"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "defaultSeasonId": { "type": "string", "minLength": 1 },
    "defaultChapterId": { "type": "string", "minLength": 1 },
    "defaultRoute": { "type": "string", "minLength": 1 },
    "metricLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "playerMetricLabels": {
      "description": "Labels for the six numbers shown to the player. The engine owns the formulas, content owns the words.",
      "type": "object",
      "required": ["usefulness", "quality", "trust", "speed", "cost", "risk"],
      "additionalProperties": false,
      "properties": {
        "usefulness": { "type": "string", "minLength": 1 },
        "quality": { "type": "string", "minLength": 1 },
        "trust": { "type": "string", "minLength": 1 },
        "speed": { "type": "string", "minLength": 1 },
        "cost": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
