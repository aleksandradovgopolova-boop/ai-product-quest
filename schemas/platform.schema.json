{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform",
  "type": "object",
  "required": ["id", "title", "defaultSeasonId", "defaultChapterId", "defaultRoute"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "defaultSeasonId": { "type": "string", "minLength": 1 },
    "defaultChapterId": { "type": "string", "minLength": 1 },
    "defaultRoute": { "type": "string", "minLength": 1 },
    "metricLabels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
